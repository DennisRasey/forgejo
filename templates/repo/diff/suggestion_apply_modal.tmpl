<dialog id="apply-suggestion-modal">
	<article>
		<header>{{ctx.Locale.Tr "repo.issues.review.apply_suggestion"}}</header>
		<form class="ui form" method="post" action="">
			<fieldset class="content">
				<div class="field">
					<label for="apply-suggestion-summary">{{ctx.Locale.Tr "form.CommitMessage"}}</label>
					<input id="apply-suggestion-summary" name="commit_summary" maxlength="100" autofocus required>
				</div>
				<div class="field">
					<textarea id="apply-suggestion-message" name="commit_message" rows="5" placeholder="{{ctx.Locale.Tr "repo.editor.commit_message_desc"}}"></textarea>
				</div>
			</fieldset>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm" "ModalButtonOkText" (ctx.Locale.Tr "repo.issues.review.apply_suggestion"))}}
		</form>
	</article>
</dialog>
